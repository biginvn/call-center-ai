# Database Configuration
MONGODB_URL=mongodb://localhost:27017
MONGODB_NAME=callcenter

# Authentication
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=600
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Configuration
CORS_ORIGINS=["*"]

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4
WHISPER_MODEL=whisper-1
TTS_MODEL=tts-1
TTS_VOICE=alloy

# OpenAI Session Configuration (for ephemeral tokens)
BACKEND_URL=https://callpilot.bigin.top/api
OPENAI_SESSION_USER=nixxisdevteam
OPENAI_SESSION_PASS=nixxisdevteam
OPENAI_SESSION_EXTENSION=116

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
S3_BUCKET=your-s3-bucket

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Recording Authentication
AUTH_USERNAME=admin
AUTH_PASSWORD=admin123

# Asterisk ARI Configuration
ARI_HOST=localhost
ARI_PORT=8088
ARI_USERNAME=thanh
ARI_PASSWORD=1234
ARI_APP_NAME=nixxis

# Application Configuration
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
RECORDING_DIR=/tmp/recordings
AUDIO_FORMAT=wav
